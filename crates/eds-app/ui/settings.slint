// edscene 设置窗口 — 按参考图还原：谷地黄强调色、半透明行带、45° 斜纹、
// 白色胶囊控件、黄色分段标记、左下角状态文字、右下角「恢复默认」。
import { ScrollView, Slider } from "std-widgets.slint";

export struct EventRow {
    id: string,
    title: string,
    hint: string,
    enabled: bool,
    status: string,
    ok: bool,
    source: string,
    file: string,
    container: string,
}

export global Palette {
    in-out property <color> accent: #f5ff01;
    in-out property <color> accent-ink: #2a2c2e;
    out property <color> ink: #2a2c2e;
    out property <color> ink-soft: #33353a;
    out property <color> muted: #55575c;
    out property <color> control: #f5f5f5;
    // Light enough that the secondary text stays legible on top of them, and
    // nearly opaque so the wallpaper stops eating the edges of the glyphs.
    out property <color> band-a: #8e908fe6;
    out property <color> band-b: #878889ea;
    out property <color> band-c: #7c777cee;
    // Slint reads #RRGGBBAA. These two were written alpha-first, so the whole
    // window was being washed in translucent red — the "泛红" that survived
    // every backdrop change.
    out property <color> panel: #545454f0;
    out property <color> veil: #545454a6;
    out property <color> focus: #35a8bb;
    out property <color> bad: #c62b2b;
    in-out property <length> radius: 10px;
    in-out property <bool> rounded: true;
    in-out property <duration> anim: 180ms;
    in-out property <bool> hatch: true;
}

// 45° 斜纹：一张 207 字节的小图平铺，任何尺寸下都不糊。
component Hatch inherits Rectangle {
    in property <float> strength: 0.45;
    clip: true;
    Image {
        source: @image-url("hatch.png");
        width: 100%;
        height: 100%;
        horizontal-tiling: repeat;
        vertical-tiling: repeat;
        opacity: root.strength;
    }
}

component Band inherits Rectangle {
    in property <color> fill: Palette.band-a;
    in property <float> hatch-strength: 0.45;
    clip: true;
    height: 54px;
    border-radius: Palette.rounded ? Palette.radius : 0px;
    background: root.fill;
    Hatch {
        visible: Palette.hatch;
        strength: root.hatch-strength;
    }
}

// 段落标题：黄色竖条 + 黑字，对应参考图的「主题 / 几何 / 动效」。
component SectionLabel inherits HorizontalLayout {
    in property <string> text;
    in property <bool> major: false;
    height: root.major ? 30px : 22px;
    spacing: 10px;
    alignment: start;
    Rectangle {
        horizontal-stretch: 0;
        width: root.major ? 8px : 4px;
        background: Palette.accent;
        border-radius: 2px;
    }
    Text {
        horizontal-stretch: 0;
        text: root.text;
        color: Palette.ink;
        font-size: root.major ? 20px : 15px;
        font-weight: root.major ? 700 : 600;
    }
}

// 两段胶囊开关（开 / 关），白色滑块带位移动画。
// 分段胶囊：每一段自己可点，两段的"开/关"和四段的"慢/标准/快/关闭"用同一个组件。
component PillSwitch inherits Rectangle {
    in property <[string]> options: ["开", "关"];
    in property <int> index: 0;
    in property <bool> enabled: true;
    in property <length> cell-width: 66px;
    callback changed(int);
    width: root.cell-width * root.options.length;
    height: 36px;
    border-radius: root.height / 2;
    background: #00000026;
    Rectangle {
        x: root.index * (parent.width / root.options.length);
        width: parent.width / root.options.length;
        height: parent.height;
        Rectangle {
            x: 3px;
            y: 3px;
            width: parent.width - 6px;
            height: parent.height - 6px;
            border-radius: (parent.height - 6px) / 2;
            background: Palette.control;
        }
        animate x { duration: Palette.anim; }
    }
    for label[idx] in root.options: Rectangle {
        x: idx * (parent.width / root.options.length);
        width: parent.width / root.options.length;
        height: 100%;
        Text {
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: label;
            color: idx == root.index ? Palette.ink : Palette.muted;
            font-size: 15px;
            font-weight: idx == root.index ? 600 : 400;
            overflow: elide;
        }
        TouchArea {
            enabled: root.enabled && idx != root.index;
            mouse-cursor: pointer;
            clicked => {
                root.changed(idx);
            }
        }
    }
}

component SmallPill inherits Rectangle {
    in property <string> text;
    in property <color> fill: Palette.control;
    in property <color> ink: Palette.ink;
    callback clicked();
    width: t.preferred-width + 34px;
    height: 30px;
    border-radius: 15px;
    background: root.fill;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    t := Text {
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.text;
        color: root.ink;
        font-size: 13px;
        font-weight: 600;
    }
    Rectangle {
        height: 100%;
        width: 100%;
        border-radius: 15px;
        border-width: ta.has-hover ? 2px : 0px;
        border-color: Palette.focus;
    }
}

component CloseButton inherits Rectangle {
    callback clicked();
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background: ta.has-hover ? Palette.control : #f5f5f5e8;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    Text {
        width: 100%;
        height: 100%;
        text: "×";
        color: Palette.ink;
        font-size: 20px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component TabCell inherits Rectangle {
    in property <int> kind: 0;
    in property <bool> active: false;
    callback clicked();
    width: 52px;
    height: 46px;
    border-radius: active ? 12px : 23px;
    background: active ? Palette.accent : Palette.control;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    // 播报 = 喇叭，外观 = 滑杆，关于 = 圈 i
    Rectangle {
        visible: root.kind == 0;
        x: 15px;
        y: 16px;
        width: 7px;
        height: 14px;
        background: Palette.ink;
        border-radius: 2px;
    }
    Path {
        visible: root.kind == 0;
        x: 22px;
        y: 13px;
        width: 13px;
        height: 20px;
        commands: "M0 6 L9 0 L9 20 L0 14 Z";
        fill: Palette.ink;
    }
    Rectangle {
        visible: root.kind == 1;
        x: 13px;
        y: 17px;
        width: 26px;
        height: 2px;
        background: Palette.ink;
    }
    Rectangle {
        visible: root.kind == 1;
        x: 13px;
        y: 27px;
        width: 26px;
        height: 2px;
        background: Palette.ink;
    }
    Rectangle {
        visible: root.kind == 1;
        x: 18px;
        y: 12px;
        width: 11px;
        height: 11px;
        border-radius: 6px;
        background: Palette.ink;
    }
    Rectangle {
        visible: root.kind == 1;
        x: 29px;
        y: 22px;
        width: 11px;
        height: 11px;
        border-radius: 6px;
        background: Palette.ink;
    }
    Rectangle {
        visible: root.kind == 2;
        x: 14px;
        y: 11px;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        border-width: 2px;
        border-color: Palette.ink;
    }
    Text {
        visible: root.kind == 2;
        x: 14px;
        y: 11px;
        width: 24px;
        height: 24px;
        text: "i";
        font-size: 15px;
        font-weight: 700;
        color: Palette.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// 一行设置：左边标签，右边按 control 决定是下拉、开关还是音量条。
component LookRow inherits Rectangle {
    in property <string> label;
    in property <string> control: "select";
    in property <[string]> options: [];
    in property <int> index: 0;
    in property <string> text: "";
    in property <float> value: 0.8;
    callback picked(int);
    callback changed(float);
    height: 54px;
    clip: true;
    Band {
        width: parent.width;
        height: parent.height;
    }
    HorizontalLayout {
        padding-left: 22px;
        padding-right: 16px;
        alignment: stretch;
        Text {
            text: root.label;
            color: Palette.ink;
            font-size: 17px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: left;
            horizontal-stretch: 1;
            min-width: 0px;
            overflow: elide;
        }
        if root.control == "select" || root.control == "switch": PillSwitch {
            options: root.control == "switch" ? ["开", "关"] : root.options;
            index: root.index;
            cell-width: root.control == "switch" ? 66px : 78px;
            vertical-stretch: 0;
            changed(i) => {
                root.picked(i);
            }
        }
        if root.control == "volume": Rectangle {
            width: 240px;
            height: 36px;
            HorizontalLayout {
                spacing: 10px;
                Slider {
                    value: root.value;
                    changed(v) => {
                        root.changed(v);
                    }
                }
                Text {
                    text: root.text;
                    color: Palette.ink;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                    width: 46px;
                }
            }
        }
    }
}

export component Tray inherits SystemTrayIcon {
    icon: @image-url("icon.png");
    tooltip: "集成工业播报终端";
    title: "edscene";
    clicked => {
        root.open();
    }
    Menu {
        MenuItem {
            title: "打开设置";
            activated => {
                root.open();
            }
        }
        MenuItem {
            title: "退出";
            activated => {
                root.quit();
            }
        }
    }
    callback open();
    callback quit();
}

export component MainWindow inherits Window {
    title: "集成工业播报终端";
    icon: @image-url("icon.png");
    // 系统标题栏 = 拖动、缩放、Win+方向线吸附全都归 Windows 管，不会出岔子；
    // 无边框时才用下面那块自绘的拖动区。
    no-frame: !root.native-frame;
    background: transparent;
    forward-focus: fs;
    default-font-size: 15px;
    preferred-width: 1000px;
    preferred-height: 660px;
    min-width: 780px;
    min-height: 540px;

    // ---- 来自 Rust 的状态
    in property <[EventRow]> rows;
    in property <string> status-text;
    in property <string> sounds-dir: "";
    in-out property <int> tab: 0;
    in property <[string]> accent-options: ["谷地黄", "武陵蓝"];
    in property <int> accent-index: 0;
    in property <[string]> blur-options: ["实时模糊", "壁纸副本", "纯色"];
    in property <int> blur-index: 2;
    in property <[string]> speed-options: ["慢", "标准", "快", "关闭"];
    in property <int> speed-index: 1;
    in property <[string]> deco-options: ["关闭", "轻", "标准", "重"];
    in property <int> deco-index: 2;
    in property <bool> top-bar-dim: true;
    in property <bool> rounded: true;
    in property <bool> autostart: true;
    in property <bool> service-ready: false;
    in property <bool> prelogon: false;
    in property <bool> tray-on: true;
    in property <string> volume-text: "80%";
    in property <float> volume: 0.8;
    in property <image> wallpaper;
    in property <bool> has-wallpaper: false;
    in property <string> version: "";
    in property <string> config-path: "";
    in property <string> backdrop-name: "";
    in property <bool> status-bad: false;
    in property <bool> need-admin: false;
    // 提权是 Windows 的概念；Linux 的自启是用户级 systemd 单元，不需要 root。
    in property <bool> can-elevate: true;
    in property <string> autostart-where: "系统服务";
    in property <string> autostart-hint: "";
    in property <bool> native-drag: false;
    in property <bool> native-frame: true;

    callback toggle-row(int, bool);
    callback preview(int);
    callback replace(int);
    callback restore-one(int);
    callback reset-defaults();
    callback pick-sounds();
    callback open-sounds-dir();
    callback set-accent(int);
    callback set-blur(int);
    callback set-speed(int);
    callback set-deco(int);
    callback set-top-bar-dim(bool);
    callback set-rounded(bool);
    callback set-frame(int);
    callback set-autostart(bool);
    callback set-prelogon(bool);
    callback set-tray(bool);
    callback set-volume(float);
    callback close-window();
    callback drag-start();
    callback drag-move();
    callback drag-end();
    callback pick-backdrop();
    callback clear-backdrop();
    callback elevate();

    // ---- 背景：壁纸副本 / 实时模糊时是一张缩过的小图，否则纯色
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Palette.rounded ? 16px : 0px;
        clip: true;
        Image {
            visible: root.has-wallpaper;
            source: root.wallpaper;
            width: 100%;
            height: 100%;
        }
        // 有壁纸时只压一层薄灰，让模糊透出来；抓不到屏幕才整面铺死灰。
        Rectangle {
            width: 100%;
            height: 100%;
            background: Palette.panel;
            visible: !root.has-wallpaper;
        }
        Rectangle {
            width: 100%;
            height: 100%;
            background: Palette.veil;
            visible: root.has-wallpaper;
        }
        // 只压顶栏：整面压暗会把背景糊成一片脏色，名字里写的也不是这个。
        Rectangle {
            width: 100%;
            height: 74px;
            background: #00000059;
            visible: root.top-bar-dim;
        }
    }

    // ---- 无边框窗口的拖动区。Slint 自带的 WindowMoveArea 在 Windows 的
    // no-frame + 透明窗口上不动（实测三个起点都不动），所以 Windows 上由
    // Rust 按光标的绝对位置搬窗口；其它平台把事件让给下面那个 WindowMoveArea。
    WindowMoveArea {
        width: 100%;
        height: 74px;
    }
    Rectangle {
        width: 100%;
        height: 74px;
        TouchArea {
            enabled: root.native-drag;
            mouse-cursor: default;
            // `moved` only fires while the button is down, so the press and the
            // release have to come from pointer-event to be seen at all.
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down) {
                    root.drag-start();
                } else if (ev.kind == PointerEventKind.move) {
                    root.drag-move();
                } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                    root.drag-end();
                }
            }
        }
    }

    Rectangle {
        x: 26px;
        y: 20px;
        width: 4px;
        height: 20px;
        background: Palette.accent;
        border-radius: 2px;
    }
    Text {
        x: 38px;
        y: 20px;
        height: 20px;
        text: "//设置";
        color: Palette.ink;
        font-size: 15px;
        font-weight: 700;
        vertical-alignment: center;
    }
    CloseButton {
        visible: !root.native-frame;
        x: root.width - 46px;
        y: 16px;
        clicked => {
            root.close-window();
        }
    }

    HorizontalLayout {
        x: 0px;
        y: 10px;
        width: 100%;
        alignment: center;
        spacing: 8px;
        TabCell {
            kind: 0;
            active: root.tab == 0;
            clicked => {
                root.tab = 0;
            }
        }
        TabCell {
            kind: 1;
            active: root.tab == 1;
            clicked => {
                root.tab = 1;
            }
        }
        TabCell {
            kind: 2;
            active: root.tab == 2;
            clicked => {
                root.tab = 2;
            }
        }
    }

    // ---- 正文
    VerticalLayout {
        x: 26px;
        y: 74px;
        width: root.width - 52px;
        height: root.height - 74px - 58px;
        spacing: 0px;

        if root.tab == 0: ScrollView {
            content-width: root.width - 52px;
            width: 100%;
            height: 100%;
            VerticalLayout {
                spacing: 18px;
                padding-top: 6px;
                SectionLabel {
                    text: "播报事件";
                    major: true;
                }
                for row[idx] in root.rows: Rectangle {
                    height: 84px;
                    VerticalLayout {
                        spacing: 4px;
                        Band {
                            height: 50px;
                            fill: Math.mod(idx, 2) == 0 ? Palette.band-a : Palette.band-b;
                            hatch-strength: row.enabled ? 0.85 : 0.4;
                            HorizontalLayout {
                                padding-left: 22px;
                                padding-right: 16px;
                                alignment: stretch;
                                Text {
                                    text: row.title;
                                    color: Palette.ink;
                                    font-size: 17px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 0;
                                }
                                Text {
                                    text: row.hint;
                                    color: row.ok ? Palette.ink-soft : Palette.bad;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    overflow: elide;
                                }
                                PillSwitch {
                                    horizontal-stretch: 0;
                                    index: row.enabled ? 0 : 1;
                                    options: ["开", "关"];
                                    vertical-stretch: 0;
                                    changed(i) => {
                                        root.toggle-row(idx, i == 0);
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            padding-left: 22px;
                            Text {
                                text: row.source + " · " + row.file + " · " + row.container + " · " + row.status;
                                color: row.ok ? Palette.muted : Palette.bad;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                overflow: elide;
                            }
                            SmallPill {
                                text: "试听";
                                clicked => {
                                    root.preview(idx);
                                }
                            }
                            SmallPill {
                                text: "替换";
                                clicked => {
                                    root.replace(idx);
                                }
                            }
                            if row.source != "预设": SmallPill {
                                text: "恢复";
                                fill: #00000033;
                                ink: Palette.ink;
                                clicked => {
                                    root.restore-one(idx);
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text {
                        text: "素材目录";
                        color: Palette.ink;
                        font-size: 15px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        height: 34px;
                        width: 100%;
                        border-radius: 17px;
                        background: #00000033;
                        Text {
                            x: 18px;
                            width: parent.width - 36px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            text: root.sounds-dir == "" ? "（未选择，点这里选一个装有播报音频的文件夹）" : root.sounds-dir;
                            color: root.sounds-dir == "" ? Palette.muted : Palette.ink;
                            font-size: 13px;
                            overflow: elide;
                        }
                        sta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.pick-sounds();
                            }
                        }
                    }
                    SmallPill {
                        text: "打开";
                        clicked => {
                            root.open-sounds-dir();
                        }
                    }
                }
                Rectangle { height: 8px; }
            }
        }

        if root.tab == 1: ScrollView {
            content-width: root.width - 52px;
            width: 100%;
            height: 100%;
            VerticalLayout {
                spacing: 10px;
                padding-top: 6px;
                SectionLabel {
                    text: "外观";
                    major: true;
                }
                SectionLabel {
                    text: "主题";
                }
                LookRow {
                    label: "强调色";
                    control: "select";
                    options: root.accent-options;
                    index: root.accent-index;
                    picked(i) => {
                        root.set-accent(i);
                    }
                }
                LookRow {
                    label: "顶栏压暗";
                    control: "switch";
                    index: root.top-bar-dim ? 0 : 1;
                    picked(i) => {
                        root.set-top-bar-dim(i == 0);
                    }
                }
                LookRow {
                    label: "背景模糊";
                    control: "select";
                    options: root.blur-options;
                    index: root.blur-index;
                    picked(i) => {
                        root.set-blur(i);
                    }
                }
                // 背景图：默认跟着系统壁纸，也可以指到自己喜欢的一张图。
                Rectangle {
                    height: 54px;
                    clip: true;
                    Band {
                        width: parent.width;
                        height: parent.height;
                    }
                    HorizontalLayout {
                        padding-left: 22px;
                        padding-right: 16px;
                        alignment: stretch;
                        Text {
                            text: "背景图片";
                            color: Palette.ink;
                            font-size: 17px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }
                        Text {
                            text: root.backdrop-name == "" ? "跟随系统桌面壁纸" : root.backdrop-name;
                            color: root.backdrop-name == "" ? Palette.muted : Palette.ink-soft;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            overflow: elide;
                        }
                        SmallPill {
                            text: "选一张";
                            horizontal-stretch: 0;
                            clicked => {
                                root.pick-backdrop();
                            }
                        }
                        if root.backdrop-name != "": SmallPill {
                            text: "跟随系统";
                            fill: #00000033;
                            ink: Palette.ink;
                            horizontal-stretch: 0;
                            clicked => {
                                root.clear-backdrop();
                            }
                        }
                    }
                }
                SectionLabel {
                    text: "几何";
                }
                LookRow {
                    label: "窗口边框";
                    control: "select";
                    options: ["无边框", "系统标题栏"];
                    index: root.native-frame ? 1 : 0;
                    picked(i) => {
                        root.set-frame(i);
                    }
                }
                LookRow {
                    label: "圆角";
                    control: "switch";
                    index: root.rounded ? 0 : 1;
                    picked(i) => {
                        root.set-rounded(i == 0);
                    }
                }
                SectionLabel {
                    text: "动效";
                }
                LookRow {
                    label: "动画速度";
                    control: "select";
                    options: root.speed-options;
                    index: root.speed-index;
                    picked(i) => {
                        root.set-speed(i);
                    }
                }
                LookRow {
                    label: "装饰强度";
                    control: "select";
                    options: root.deco-options;
                    index: root.deco-index;
                    picked(i) => {
                        root.set-deco(i);
                    }
                }
                LookRow {
                    label: "总音量";
                    control: "volume";
                    text: root.volume-text;
                    value: root.volume;
                    changed(v) => {
                        root.set-volume(v);
                    }
                }
                Rectangle { height: 10px; }
            }
        }

        if root.tab == 2: ScrollView {
            content-width: root.width - 52px;
            width: 100%;
            height: 100%;
            VerticalLayout {
                spacing: 10px;
                padding-top: 6px;
                SectionLabel {
                    text: "启动";
                    major: true;
                }
                LookRow {
                    label: "开机自启";
                    control: "switch";
                    index: root.autostart ? 0 : 1;
                    picked(i) => {
                        root.set-autostart(i == 0);
                    }
                }
                LookRow {
                    label: "登录界面播报";
                    control: "switch";
                    index: root.prelogon ? 0 : 1;
                    picked(i) => {
                        root.set-prelogon(i == 0);
                    }
                }
                LookRow {
                    label: "托盘常驻";
                    control: "switch";
                    index: root.tray-on ? 0 : 1;
                    picked(i) => {
                        root.set-tray(i == 0);
                    }
                }
                Band {
                    height: 96px;
                    fill: Palette.band-c;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 6px;
                        Text {
                            text: "开机自启 = " + root.autostart-where + (root.service-ready ? "（已注册）" : "（未注册）");
                            color: Palette.ink;
                            font-size: 13px;
                            font-weight: 600;
                        }
                        Text {
                            text: root.autostart-hint;
                            color: Palette.ink-soft;
                            font-size: 12px;
                            wrap: word-wrap;
                            horizontal-alignment: left;
                        }
                    }
                }
                SectionLabel {
                    text: "关于";
                }
                Band {
                    height: 118px;
                    fill: Palette.band-b;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 4px;
                        Text {
                            text: "edscene " + root.version;
                            color: Palette.ink;
                            font-size: 15px;
                            font-weight: 700;
                        }
                        Text {
                            text: "明日方舟：终末地 同人二创工具，与鹰角网络无隶属、无授权关系；相关商标与著作权归各自权利人所有，本程序不含任何官方素材。";
                            color: Palette.ink-soft;
                            font-size: 12px;
                            wrap: word-wrap;
                            horizontal-alignment: left;
                        }
                        Text {
                            text: "配置 " + root.config-path;
                            color: Palette.muted;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                }
                Rectangle { height: 10px; }
            }
        }
    }

    // ---- 页脚
    // ---- 页脚：反馈要看得见；需要管理员时给一个能按的按钮，而不是小字。
    Rectangle {
        x: 26px;
        y: root.height - 52px;
        width: Math.min(560px, root.width - 220px);
        height: 38px;
        visible: root.status-text != "";
        border-radius: 19px;
        background: root.status-bad ? #4a1d1df0 : #101413e6;
        border-width: 2px;
        border-color: root.status-bad ? #e0575b : Palette.accent;
        Text {
            x: 16px;
            width: parent.width - 32px;
            vertical-alignment: center;
            text: root.status-text;
            color: root.status-bad ? #ffd9d9 : #f2f2ef;
            font-size: 14px;
            font-weight: 600;
            overflow: elide;
        }
    }
    if root.need-admin && root.can-elevate: Rectangle {
        x: 26px;
        y: root.height - 100px;
        width: 196px;
        height: 36px;
        border-radius: 18px;
        background: Palette.accent;
        ata := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.elevate();
            }
        }
        Text {
            x: 16px;
            width: parent.width - 32px;
            vertical-alignment: center;
            text: "以管理员身份开启";
            color: Palette.accent-ink;
            font-size: 14px;
            font-weight: 700;
        }
        Rectangle {
            height: 100%;
            width: 100%;
            border-radius: 18px;
            border-width: ata.has-hover ? 2px : 0px;
            border-color: Palette.focus;
        }
    }
    Rectangle {
        x: root.width - 152px;
        y: root.height - 46px;
        width: 126px;
        height: 34px;
        border-radius: 17px;
        background: Palette.control;
            rta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.reset-defaults();
            }
        }
        Text {
            x: 18px;
            vertical-alignment: center;
            text: "恢复默认";
            color: Palette.ink;
            font-size: 14px;
            font-weight: 600;
        }
        Path {
            x: 98px;
            y: 9px;
            width: 16px;
            height: 16px;
            commands: "M13 3 A6 6 0 1 0 15 8 M13 3 L13 0 M13 3 L10 4";
            stroke: Palette.ink;
            stroke-width: 2px;
        }
        Rectangle {
            height: 100%;
            width: 100%;
            border-radius: 17px;
            border-width: rta.has-hover ? 2px : 0px;
            border-color: Palette.focus;
        }
    }

    // ---- 键盘：Esc 关闭窗口
    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == "\u{1b}") {
                root.close-window();
                return accept;
            }
            return reject;
        }
    }
}
